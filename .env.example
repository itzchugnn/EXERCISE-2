# ========================================================
# FILE MẪU CẤU HÌNH MÔI TRƯỜNG (ENVIRONMENT VARIABLES)
# ========================================================
# HƯỚNG DẪN CHO THÀNH VIÊN TRONG NHÓM:
# 1. Tạo một bản sao của file này và đặt tên là: .env
# 2. Cập nhật các thông số bên dưới cho phù hợp với máy cá nhân của bạn.
# 3. File .env sẽ được .gitignore bỏ qua, không bị đẩy lên GitHub.

# --- CẤU HÌNH SERVER ---
PORT=5000
NODE_ENV=development
APP_NAME="IS Web Project"

# --- CẤU HÌNH CƠ SỞ DỮ LIỆU (DATABASE CONFIG) ---
# Điền thông tin kết nối CSDL của bạn (PostgreSQL / MySQL / SQL Server)
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=project_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# --- BẢO MẬT & XÁC THỰC (AUTH & SECURITY) ---
JWT_SECRET=super_secret_jwt_key_change_me_in_production
JWT_EXPIRES_IN=1d

# --- CORS (FRONTEND URL) ---
CLIENT_URL=http://localhost:3000
